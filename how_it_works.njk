<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ how_it_works.title }}</title>
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/how_it_works.css" />
</head>
<body class="page-how-it-works">

  <header class="site-header">
    <div class="nav">
        <a class="nav-logo" href="index.html">The Fulcrum</a>
        <ul class="nav-list">
          <li><a href="index.html">Видение лидера</a></li>
          <li><a href="holistic.html">Холистический подход</a></li>
          <li><a href="apitherapy.html">Апитерапия</a></li>
          <li><a href="phytotherapy.html">Фитотерапия</a></li>
          <li><a href="how_it_works.html" class="active">Как это работает</a></li>
        </ul>
        <button class="nav-toggle" aria-label="Открыть меню" aria-expanded="false">
        ☰
        </button>
    </div>

    <nav class="side-nav" aria-hidden="true">
      <button class="side-close" aria-label="Закрыть меню">✕</button>
      <ul>
        <li><a href="index.html">Видение лидера</a></li>
        <li><a href="holistic.html">Холистический подход</a></li>
        <li><a href="apitherapy.html">Апитерапия</a></li>
        <li><a href="phytotherapy.html">Фитотерапия</a></li>
        <li><a href="how_it_works.html">Как это работает</a></li>
      </ul>
    </nav>
  </header>

  <main class="container">

    {# --- HERO --- #}
    <section class="science-hero">
        <div class="hero-overlay"></div>
        <img src="{{ how_it_works.hero.image }}" alt="{{ how_it_works.hero.alt }}" class="hero-bg" />
        <div class="hero-content">
            <h1>{{ how_it_works.hero.h1 }}</h1>
            <p class="lead">{{ how_it_works.hero.lead }}</p>
        </div>
    </section>

    <article class="content scientific-content">

        {# --- DYNAMIC BLOCKS --- #}
        {% if how_it_works.page_blocks %}
        {% for block in how_it_works.page_blocks %}

            {% if block.type == 'h2' %}
                <h2>{{ block.text }}</h2>

            {% elif block.type == 'paragraph' %}
                <p>{{ block.text | safe }}</p>

            {% elif block.type == 'list' %}
                {% if block.data.items %}
                <ul>
                    {% for item in block.data.items %}
                        <li>{{ item | safe }}</li>
                    {% endfor %}
                </ul>
                {% endif %}

            {% elif block.type == 'energy_breakdown' %}
                <div class="energy-chart-block">
                    <h3>{{ block.title }}</h3>
                    {% if block.description %}
                        <p class="chart-desc">{{ block.description }}</p>
                    {% endif %}
                    <div class="chart-bars">
                        {% for item in block.items %}
                        <div class="bar-item">
                            <div class="bar-label">
                                <span class="organ-name">{{ item.organ }}</span>
                                <span class="organ-percent">{{ item.percent }}%</span>
                            </div>
                            <div class="bar-track">
                                <div class="bar-fill" style="width: {{ item.percent }}%;"></div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>

            {# --- ФИГУРА (изображение + подпись) --- #}
            {% elif block.type == 'figure' %}
                <figure class="figure-block">
                    <img src="{{ block.image }}" alt="{{ block.alt }}" />
                    {% if block.caption %}
                        <figcaption>{{ block.caption }}</figcaption>
                    {% endif %}
                </figure>

            {# --- БЛОК: ATP (кратко, с диаграммой) --- #}
            {% elif block.type == 'atp_block' %}
                <section class="atp-block">
                    <div class="atp-left">
                        <h3>{{ block.title }}</h3>
                        <p>{{ block.text }}</p>
                        {% if block.key_points_data.points %}
                            <ul class="atp-points">
                                {% for p in block.key_points_data.points %}
                                    <li>{{ p }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                    <div class="atp-right">
                        <img src="{{ block.image }}" alt="{{ block.image_alt }}" />
                        {% if block.image_note %}<p class="muted small">{{ block.image_note }}</p>{% endif %}
                    </div>
                </section>

            {# --- СРАВНЕНИЕ: гликоген vs жир --- #}
            {% elif block.type == 'compare_glycogen_fat' %}
                <section class="compare-block">
                    <h3>{{ block.title }}</h3>
                    <div class="compare-inner">
                        <div class="compare-col">
                            <h4>{{ block.left.title }}</h4>
                            <ul>
                                {% for it in block.left.items %}
                                    <li>{{ it }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="compare-col">
                            <h4>{{ block.right.title }}</h4>
                            <ul>
                                {% for it in block.right.items %}
                                    <li>{{ it }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                    {% if block.note %}<p class="compare-note">{{ block.note }}</p>{% endif %}
                </section>

            {# --- БЛОК: Energy flow (пошагово) --- #}
            {% elif block.type == 'energy_flow' %}
                <section class="energy-flow">
                    <h3>{{ block.title }}</h3>
                    <ol>
                        {% for step in block.steps %}
                            <li>
                                <strong>{{ step.title }}.</strong> {{ step.text }}
                            </li>
                        {% endfor %}
                    </ol>
                </section>

            {% elif block.type == 'source_credit' %}
                <div class="source-citation">
                    <p>{{ block.intro }}</p>
                    <a href="{{ block.link_url }}" target="_blank" rel="noopener noreferrer" class="source-link">
                        {{ block.link_label }} ↗
                    </a>
                </div>

            {% elif block.type == 'manifesto_block' %}
                <div class="manifesto-box">
                    <p>{{ block.text }}</p>
                </div>
            {% endif %}

        {% endfor %}
        {% endif %}

    </article>
  </main>

  <footer class="site-footer">
    <p>© The Fulcrum — Портал здоровья</p>
  </footer>

  <script src="/script/menu.js"></script>
</body>
</html>
