<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ apitherapy.title }}</title>
  <link rel="stylesheet" href="css/base.css" />
  <link rel="stylesheet" href="css/apitherapy.css" />
</head>
<body class="page-apitherapy">

  <header class="site-header">
    <div class="nav">
      <a class="nav-logo" href="index.html">The Fulcrum</a>
      <ul class="nav-list">
        <li><a href="index.html">Видение лидера</a></li>
        <li><a href="holistic.html">Холистический подход</a></li>
        <li><a href="apitherapy.html" class="active">Апитерапия</a></li>
        <li><a href="phytotherapy.html">Фитотерапия</a></li>
        <li><a href="how_it_works.html">Как это работает</a></li>
      </ul>
      <button class="nav-toggle" aria-label="Открыть меню" aria-expanded="false">☰</button>
    </div>

    <nav class="side-nav" aria-hidden="true">
      <button class="side-close" aria-label="Закрыть меню">✕</button>
      <ul>
        <li><a href="index.html">Видение лидера</a></li>
        <li><a href="holistic.html">Холистический подход</a></li>
        <li><a href="apitherapy.html">Апитерапия</a></li>
        <li><a href="phytotherapy.html">Фитотерапия</a></li>
        <li><a href="how_it_works.html">Как это работает</a></li>
      </ul>
    </nav>
  </header>

  <main class="container">
    <section class="apitherapy-hero">
      <img src="{{ apitherapy.hero.image }}" alt="{{ apitherapy.hero.alt }}" class="hero-header" />
      <div class="hero-copy">
        <h1>{{ apitherapy.hero.h1 }}</h1>
        <p class="lead">{{ apitherapy.hero.lead }}</p>
      </div>
    </section>

    <article class="content">
      {# --- Блок Intro (фиксированный) --- #}
      <section class="intro-row">
        <figure class="intro-photo">
            <img src="{{ apitherapy.intro.photo.src }}" alt="{{ apitherapy.intro.photo.alt }}" />
        </figure>

        <div class="intro-text">
            <h2>{{ apitherapy.intro.heading }}</h2>
            <p>{{ apitherapy.intro.text }}</p>
        </div>
      </section>

      {# --- ДИНАМИЧЕСКИЕ БЛОКИ --- #}
      {% if apitherapy.page_blocks %}
      {% for block in apitherapy.page_blocks %}

{# 1. Секция: Перечень сфер (Список с колонками) #}
        {% if block.type == 'conditions_section' %}
          <section class="conditions">
            <h3>{{ block.title }}</h3>
            
            {# 1. Вычисляем середину. Округляем вверх (ceil), чтобы левая колонка была длиннее, если число нечетное #}
            {# В Nunjucks нет math.ceil из коробки, но можно использовать round(0, 'ceil') #}
            {% set mid_point = (block.items.length / 2) | round(0, 'ceil') %} 
            
            <div class="columns">
              
              {# --- СПИСОК 1 (Левая колонка) --- #}
              {# Берем элементы с индекса 0 до середины #}
              <ul>
                {% for item in block.items.slice(0, mid_point) %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
              
              {# --- СПИСОК 2 (Правая колонка) --- #}
              {# Берем элементы от середины до конца #}
              <ul>
                {% for item in block.items.slice(mid_point) %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
              
            </div>
          </section>

        {# 2. Секция: Как это работает (Текст) #}
        {% elif block.type == 'how_it_works_section' %}
          <section class="how-it-works">
            <h3>{{ block.title }}</h3>
            <p>{{ block.text | safe }}</p>
          </section>

        {# 3. Секция: Галерея #}
        {% elif block.type == 'gallery_section' %}
          <section class="gallery">
            {% for img in block.gallery_items %}
            <figure>
              <img src="{{ img.image_src }}" alt="{{ img.alt }}" />
              <figcaption>{{ img.caption }}</figcaption>
            </figure>
            {% endfor %}
          </section>

        {# 4. Секция: Важно/Заметки (Текст) #}
        {% elif block.type == 'notes_section' %}
          <section class="notes">
            <h3>{{ block.title }}</h3>
            <p>{{ block.text | safe }}</p>
          </section>

        {% endif %}

      {% endfor %}
      {% endif %}
      {# --- КОНЕЦ БЛОКОВ --- #}

    </article>
  </main>

  <footer class="site-footer">
    <p>© The Fulcrum — Портал здоровья</p>
  </footer>

  <script src="script/menu.js"></script>

</body>
</html>